{
  "name": "go-filewatcher-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website and documentation for go-filewatcher — a high-performance, composable file system watcher for Go",
  "keywords": [
    "astro",
    "debounce",
    "file-watcher",
    "filesystem",
    "filters",
    "fsnotify",
    "go",
    "golang",
    "middleware",
    "starlight"
  ],
  "homepage": "https://filewatcher.lars.software",
  "bugs": "https://github.com/larsartmann/go-filewatcher/issues",
  "license": "MIT",
  "author": "LarsArtmann <lars@larsartmann.com> (https://larsartmann.com/)",
  "repository": {
    "type": "git",
    "url": "https://github.com/larsartmann/go-filewatcher.git",
    "directory": "website"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-changelog.mjs && astro dev",
    "build": "node scripts/sync-changelog.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "clean": "rm -rf dist .astro node_modules/.cache",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.5",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.6",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "html-validate": "^11.16.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "brace-expansion": "5.0.6"
  },
  "packageManager": "pnpm@11.20.0"
}
